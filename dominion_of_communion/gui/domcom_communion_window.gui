window = {
  name = "domcom_communion_window"
  layer = top
  parentanchor = center
  size = { 1120 820 }
  movable = yes
  visible = "[GetPlayer.MakeScope.Var('domcom_ui_open').IsSet]"

  using = Window_Background
  using = Window_Decoration

  widget = {
    name = "domcom_communion_autopause"
    size = { 0 0 }
    visible = "[And(GetPlayer.MakeScope.Var('domcom_ui_open').IsSet, Not(IsGamePaused))]"
    visible_at_creation = no
    state = {
      name = _show
      on_start = "[OnPause]"
    }
  }

  vbox = {
    layoutpolicy_horizontal = expanding
    layoutpolicy_vertical = expanding
    margin = { 26 22 }

    # HEADER
    hbox = {
      layoutpolicy_horizontal = expanding
      margin_bottom = 10

      vbox = {
        layoutpolicy_horizontal = expanding
        spacing = 2
        text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_TITLE fontsize = 24 min_height = 28 align = left }
        text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_SUBTITLE min_height = 20 align = left default_format = "#weak" }
      }

      button_standard_small = {
        text = DOMCOM_UI_CLOSE
        size = { 92 30 }
        margin_right = 10
        shortcut = close_window
        onclick = "[GetScriptedGui('domcom_ui_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      }
    }

    divider = { layoutpolicy_horizontal = expanding }

    hbox = {
      layoutpolicy_horizontal = expanding
      layoutpolicy_vertical = expanding

      # SIDEBAR
      vbox = {
        margin = { 6 10 }
        layoutpolicy_vertical = expanding
        spacing = 7
        button_standard_small = { text = DOMCOM_UI_PAGE_OVERVIEW size = { 154 32 } onclick = "[GetScriptedGui('domcom_ui_set_page_overview').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        button_standard_small = { text = DOMCOM_UI_PAGE_CUCKED size = { 154 32 } onclick = "[GetScriptedGui('domcom_ui_set_page_cucked').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        button_standard_small = { text = DOMCOM_UI_PAGE_WORLD_CUCKS size = { 154 32 } onclick = "[GetScriptedGui('domcom_ui_set_page_world_cucks').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        button_standard_small = { text = DOMCOM_UI_PAGE_OWNED size = { 154 32 } onclick = "[GetScriptedGui('domcom_ui_set_page_owned').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        button_standard_small = { text = DOMCOM_UI_PAGE_LOVERS size = { 154 32 } onclick = "[GetScriptedGui('domcom_ui_set_page_lovers').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        button_standard_small = { text = DOMCOM_UI_PAGE_PROSPECTS size = { 154 32 } onclick = "[GetScriptedGui('domcom_ui_set_page_prospects').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        button_standard_small = { text = DOMCOM_UI_PAGE_BLOOD size = { 154 32 } onclick = "[GetScriptedGui('domcom_ui_set_page_blood').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        button_standard_small = { text = DOMCOM_UI_PAGE_TANTALIZED size = { 154 32 } onclick = "[GetScriptedGui('domcom_ui_set_page_tantalized').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        button_standard_small = { text = DOMCOM_UI_PAGE_SECRETS size = { 154 32 } onclick = "[GetScriptedGui('domcom_ui_set_page_secrets').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        button_standard_small = { text = DOMCOM_UI_PAGE_IMPERIAL size = { 154 32 } onclick = "[GetScriptedGui('domcom_ui_set_page_imperial').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        button_standard_small = { text = DOMCOM_UI_PAGE_LEDGER size = { 154 32 } onclick = "[GetScriptedGui('domcom_ui_set_page_ledger').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        button_standard_small = { text = DOMCOM_UI_PAGE_HELP size = { 154 32 } onclick = "[GetScriptedGui('domcom_ui_set_page_help').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        expand = {}
        button_standard_small = { text = DOMCOM_UI_REFRESH size = { 154 30 } tooltip = DOMCOM_UI_REFRESH_TT onclick = "[GetScriptedGui('domcom_ui_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        button_standard_small = { text = DOMCOM_UI_DEEP_SCAN size = { 154 30 } tooltip = DOMCOM_UI_DEEP_SCAN_TT enabled = "[GetScriptedGui('domcom_ui_deep_scan').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('domcom_ui_deep_scan').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        text_multi = { text = DOMCOM_UI_SIDEBAR_NOTE autoresize = yes max_width = 152 max_width = 154 default_format = "#weak" }
      }

      divider = { layoutpolicy_vertical = expanding }

      # PAGE AREA
      vbox = {
        name = "domcom_page_content"
        layoutpolicy_horizontal = expanding
        layoutpolicy_vertical = expanding
        margin_left = 8

        # OVERVIEW
        vbox = {
          visible = "[GetScriptedGui('domcom_ui_is_page_overview').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
          layoutpolicy_horizontal = expanding
          layoutpolicy_vertical = expanding
          spacing = 10

          text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_OVERVIEW_TITLE fontsize = 22 min_height = 30 align = left }

          # The Overview is short enough to live directly in the page. Keeping it inside a scrollbox let
          # CK3 center the intrinsic-width content, which pushed the opening flavor text rightward and
          # clipped its last words.
          vbox = {
            layoutpolicy_horizontal = expanding
            spacing = 10

            text_multi = { autoresize = yes max_width = 800 layoutpolicy_horizontal = expanding text = DOMCOM_UI_OVERVIEW_FLAVOR default_format = "#weak" }
            divider = { layoutpolicy_horizontal = expanding }
            text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_OVERVIEW_ROSTER fontsize = 15 min_height = 22 align = center }
            text_multi = { autoresize = yes max_width = 800 layoutpolicy_horizontal = expanding text = DOMCOM_UI_OVERVIEW_COUNTS }
            divider = { layoutpolicy_horizontal = expanding }
            text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_OVERVIEW_RULE fontsize = 15 min_height = 22 align = center }
            text_multi = { autoresize = yes max_width = 800 layoutpolicy_horizontal = expanding text = DOMCOM_UI_OVERVIEW_RULE_TEXT default_format = "#weak" }

            hbox = {
              layoutpolicy_horizontal = expanding
              spacing = 10
              button_primary = { text = DOMCOM_UI_VIEW_CUCKED size = { 202 38 } onclick = "[GetScriptedGui('domcom_ui_set_page_cucked').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
              button_standard = { text = DOMCOM_UI_VIEW_OWNED size = { 202 38 } onclick = "[GetScriptedGui('domcom_ui_set_page_owned').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
              button_standard = { text = DOMCOM_UI_VIEW_BLOOD size = { 202 38 } onclick = "[GetScriptedGui('domcom_ui_set_page_blood').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
              expand = {}
            }

            hbox = {
              layoutpolicy_horizontal = expanding
              spacing = 10
              button_primary = {
                text = DOMCOM_UI_ENFORCE_DOMINION size = { 220 34 }
                tooltip = DOMCOM_UI_ENFORCE_DOMINION_TT
                enabled = "[GetScriptedGui('domcom_ui_enforce_dominion').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onclick = "[GetScriptedGui('domcom_ui_enforce_dominion').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
              }
              text_multi = { autoresize = yes max_width = 560 layoutpolicy_horizontal = expanding text = DOMCOM_UI_ENFORCE_DOMINION_INLINE default_format = "#weak" }
            }

            text_multi = { autoresize = yes max_width = 800 layoutpolicy_horizontal = expanding text = DOMCOM_UI_RETRO_NOTE default_format = "#P" }
            expand = {}
          }
        }

        # CUCKED
        vbox = {
          visible = "[GetScriptedGui('domcom_ui_is_page_cucked').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
          layoutpolicy_horizontal = expanding
          layoutpolicy_vertical = expanding
          spacing = 8

          text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_CUCKED_TITLE fontsize = 22 min_height = 30 align = left }
          text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_CUCKED_FLAVOR default_format = "#weak" }
          text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_CUCKED_SCALE default_format = "#high" }

          hbox = {
            layoutpolicy_horizontal = expanding
            spacing = 4
            text_single = { text = DOMCOM_UI_SORT_LABEL size = { 42 26 } align = left default_format = "#weak" }
            button_standard_small = { text = DOMCOM_UI_SORT_RANK size = { 70 26 } onclick = "[GetScriptedGui('domcom_ui_sort_rank').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_ENDOW size = { 70 26 } tooltip = DOMCOM_UI_SORT_ENDOW_TT onclick = "[GetScriptedGui('domcom_ui_sort_endowment').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_ALPHA size = { 70 26 } onclick = "[GetScriptedGui('domcom_ui_sort_alpha').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_XP size = { 54 26 } onclick = "[GetScriptedGui('domcom_ui_sort_xp').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_DIP size = { 54 26 } onclick = "[GetScriptedGui('domcom_ui_sort_diplomacy').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_MAR size = { 54 26 } onclick = "[GetScriptedGui('domcom_ui_sort_martial').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_STE size = { 54 26 } onclick = "[GetScriptedGui('domcom_ui_sort_stewardship').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_INT size = { 54 26 } onclick = "[GetScriptedGui('domcom_ui_sort_intrigue').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_LEA size = { 54 26 } onclick = "[GetScriptedGui('domcom_ui_sort_learning').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_PRO size = { 54 26 } onclick = "[GetScriptedGui('domcom_ui_sort_prowess').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_TOTAL size = { 60 26 } tooltip = DOMCOM_UI_SORT_TOTAL_TT onclick = "[GetScriptedGui('domcom_ui_sort_total').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_PRIZE size = { 62 26 } tooltip = DOMCOM_UI_SORT_PRIZE_TT onclick = "[GetScriptedGui('domcom_ui_sort_prize').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            expand = {}
          }

          hbox = {
            layoutpolicy_horizontal = expanding
            spacing = 4
            text_single = { text = DOMCOM_UI_SHOW_LABEL size = { 42 26 } align = left default_format = "#weak" }
            button_standard_small = { text = DOMCOM_UI_FILTER_ALL size = { 68 26 } onclick = "[GetScriptedGui('domcom_ui_filter_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_FILTER_LANDED size = { 80 26 } onclick = "[GetScriptedGui('domcom_ui_filter_landed').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_FILTER_DUKE size = { 80 26 } onclick = "[GetScriptedGui('domcom_ui_filter_dukeplus').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_FILTER_KING size = { 80 26 } onclick = "[GetScriptedGui('domcom_ui_filter_kingplus').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_REVERSE size = { 90 26 } onclick = "[GetScriptedGui('domcom_ui_sort_reverse').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            expand = {}
          }

          hbox = {
            layoutpolicy_horizontal = expanding
            expand = {}
            button_primary = {
              text = DOMCOM_UI_ALPHA_GAUNTLET size = { 225 32 }
              tooltip = DOMCOM_UI_ALPHA_GAUNTLET_TT
              enabled = "[GetScriptedGui('domcom_ui_alpha_gauntlet').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
              onclick = "[GetScriptedGui('domcom_ui_alpha_gauntlet').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            }
            expand = {}
          }

          text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_CUCKED_VISIBLE_COUNT default_format = "#weak" }
          text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_CUCKED_RANGE default_format = "#weak" }
          divider = { layoutpolicy_horizontal = expanding }

          scrollbox = {
            name = "domcom_cucked_scroll"
            layoutpolicy_horizontal = expanding
            layoutpolicy_vertical = expanding
            min_height = 240
            blockoverride "scrollbox_content" {
              vbox = {
                layoutpolicy_horizontal = expanding
                datamodel = "[GetPlayer.MakeScope.GetList('domcom_ui_cucked_page_list')]"
                spacing = 4
                item = {
                  hbox = {
                    layoutpolicy_horizontal = expanding
                    datacontext = "[Scope.GetCharacter]"
                    spacing = 7
                    min_height = 132

                    portrait_head_small = {}

                    vbox = {
                      min_width = 335 max_width = 335
                      spacing = 1
                      text_single = { layoutpolicy_horizontal = expanding text = "[Character.GetShortUINameNoTooltip]" max_width = 335 align = left }
                      text_single = { layoutpolicy_horizontal = expanding visible = "[GetScriptedGui('domcom_ui_cuck_link_soulmate').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" text = DOMCOM_UI_CUCK_LINK_SOULMATE max_width = 335 default_format = "#high" align = left }
                      text_single = { layoutpolicy_horizontal = expanding visible = "[GetScriptedGui('domcom_ui_cuck_link_lover').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" text = DOMCOM_UI_CUCK_LINK_LOVER max_width = 335 default_format = "#high" align = left }
                      text_single = { layoutpolicy_horizontal = expanding visible = "[GetScriptedGui('domcom_ui_cuck_link_bound').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" text = DOMCOM_UI_CUCK_LINK_BOUND max_width = 335 default_format = "#high" align = left }
                      text_single = { layoutpolicy_horizontal = expanding visible = "[GetScriptedGui('domcom_ui_cuck_link_blood').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" text = DOMCOM_UI_CUCK_LINK_BLOOD max_width = 335 default_format = "#high" align = left }
                      text_single = { layoutpolicy_horizontal = expanding visible = "[GetScriptedGui('domcom_ui_cuck_link_historical').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" text = DOMCOM_UI_CUCK_LINK_HISTORICAL max_width = 335 default_format = "#weak" align = left }
                      text_single = { layoutpolicy_horizontal = expanding visible = "[GetScriptedGui('domcom_ui_cuck_link_none').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" text = DOMCOM_UI_CUCK_LINK_NONE max_width = 335 default_format = "#weak" align = left }
                      vbox = {
                        spacing = 2
                        text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_ROW_SKILLS align = left }
                        text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_ROW_VITALS align = left default_format = "#weak" }
                        text_single = { layoutpolicy_horizontal = expanding visible = "[GetScriptedGui('domcom_ui_has_measurements').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" text = DOMCOM_UI_ROW_ENDOWMENT align = left default_format = "#weak" }
                        fixedgridbox = {
                          datamodel = "[Character.GetTraits]"
                          flipdirection = yes
                          addcolumn = 27
                          addrow = 27
                          datamodel_wrap = 9
                          maximumsize = { 250 54 }
                          item = { icon = { size = { 25 25 } texture = "[Trait.GetIcon( Character.GetSex )]" } }
                        }
                      }
                    }

                    vbox = {
                      min_width = 130 max_width = 130
                      spacing = 1
                      text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_ROW_XP max_width = 130 default_format = "#weak" align = left }
                      text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_ROW_ALPHA_CHANCE max_width = 130 default_format = "#high" align = left }
                    }

                    expand = {}

                    button_primary = {
                      text = DOMCOM_UI_ALPHA_CHECK size = { 112 30 }
                      tooltip = DOMCOM_UI_ALPHA_CHECK_TT
                      enabled = "[GetScriptedGui('domcom_ui_alpha_check').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
                      onclick = "[GetScriptedGui('domcom_ui_alpha_check').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
                    }
                  }
                }
              }
            }
          }

          hbox = {
            layoutpolicy_horizontal = expanding
            spacing = 6
            button_standard_small = {
              text = DOMCOM_UI_PAGE_FIRST
              size = { 90 30 }
              enabled = "[GetScriptedGui('domcom_ui_cucked_first').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
              onclick = "[GetScriptedGui('domcom_ui_cucked_first').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            }
            button_standard_small = {
              text = DOMCOM_UI_PAGE_PREV
              size = { 110 30 }
              enabled = "[GetScriptedGui('domcom_ui_cucked_prev').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
              onclick = "[GetScriptedGui('domcom_ui_cucked_prev').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            }
            expand = {}
            text_single = { text = DOMCOM_UI_CUCKED_PAGE_OF align = center|vcenter }
            expand = {}
            button_standard_small = {
              text = DOMCOM_UI_PAGE_NEXT
              size = { 110 30 }
              enabled = "[GetScriptedGui('domcom_ui_cucked_next').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
              onclick = "[GetScriptedGui('domcom_ui_cucked_next').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            }
          }
          text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_CUCKED_RIGHTCLICK_NOTE default_format = "#weak" }
        }

        # WORLD CUCKS — AI / OTHER PATRONS
        vbox = {
          visible = "[GetScriptedGui('domcom_ui_is_page_world_cucks').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
          layoutpolicy_horizontal = expanding
          layoutpolicy_vertical = expanding
          spacing = 8

          text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_WORLD_CUCKS_TITLE fontsize = 22 min_height = 30 align = left }
          text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_WORLD_CUCKS_FLAVOR default_format = "#weak" }
          text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_WORLD_CUCKS_COUNT default_format = "#high" }
          text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_WORLD_CUCK_RANGE default_format = "#weak" }
          hbox = {
            layoutpolicy_horizontal = expanding
            spacing = 4
            text_single = { text = DOMCOM_UI_SORT_LABEL size = { 42 26 } align = left default_format = "#weak" }
            button_standard_small = { text = DOMCOM_UI_SORT_RANK size = { 70 26 } onclick = "[GetScriptedGui('domcom_ui_sort_rank').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_ENDOW size = { 70 26 } onclick = "[GetScriptedGui('domcom_ui_sort_endowment').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_XP size = { 54 26 } onclick = "[GetScriptedGui('domcom_ui_sort_xp').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_DIP size = { 54 26 } onclick = "[GetScriptedGui('domcom_ui_sort_diplomacy').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_MAR size = { 54 26 } onclick = "[GetScriptedGui('domcom_ui_sort_martial').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_STE size = { 54 26 } onclick = "[GetScriptedGui('domcom_ui_sort_stewardship').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_INT size = { 54 26 } onclick = "[GetScriptedGui('domcom_ui_sort_intrigue').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_LEA size = { 54 26 } onclick = "[GetScriptedGui('domcom_ui_sort_learning').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_PRO size = { 54 26 } onclick = "[GetScriptedGui('domcom_ui_sort_prowess').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_TOTAL size = { 60 26 } tooltip = DOMCOM_UI_SORT_TOTAL_TT onclick = "[GetScriptedGui('domcom_ui_sort_total').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_PRIZE size = { 62 26 } tooltip = DOMCOM_UI_SORT_PRIZE_TT onclick = "[GetScriptedGui('domcom_ui_sort_prize').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard_small = { text = DOMCOM_UI_SORT_REVERSE size = { 90 26 } onclick = "[GetScriptedGui('domcom_ui_sort_reverse').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            expand = {}
          }
          divider = { layoutpolicy_horizontal = expanding }

          scrollbox = {
            name = "domcom_world_cucks_scroll"
            layoutpolicy_horizontal = expanding
            layoutpolicy_vertical = expanding
            min_height = 260
            blockoverride "scrollbox_content" {
              vbox = {
                layoutpolicy_horizontal = expanding
                datamodel = "[GetPlayer.MakeScope.GetList('domcom_ui_world_page_list')]"
                spacing = 4
                item = {
                  hbox = {
                    layoutpolicy_horizontal = expanding
                    datacontext = "[Scope.GetCharacter]"
                    spacing = 7
                    min_height = 126

                    portrait_head_small = {}
                    vbox = {
                      min_width = 300 max_width = 300
                      spacing = 1
                      text_single = { layoutpolicy_horizontal = expanding text = "[Character.GetShortUINameNoTooltip]" max_width = 300 align = left }
                      text_single = { layoutpolicy_horizontal = expanding visible = "[GetScriptedGui('domcom_ui_world_cuck_origin_known').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" text = DOMCOM_UI_WORLD_CUCKED_BY max_width = 300 default_format = "#high" align = left }
                      text_single = { layoutpolicy_horizontal = expanding visible = "[GetScriptedGui('domcom_ui_world_cuck_origin_unknown').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" text = DOMCOM_UI_WORLD_CUCKED_BY_UNKNOWN max_width = 300 default_format = "#weak" align = left }
                      vbox = {
                        spacing = 2
                        text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_ROW_SKILLS align = left }
                        text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_ROW_VITALS align = left default_format = "#weak" }
                        text_single = { layoutpolicy_horizontal = expanding visible = "[GetScriptedGui('domcom_ui_has_measurements').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" text = DOMCOM_UI_ROW_ENDOWMENT align = left default_format = "#weak" }
                        fixedgridbox = {
                          datamodel = "[Character.GetTraits]"
                          flipdirection = yes
                          addcolumn = 27
                          addrow = 27
                          datamodel_wrap = 9
                          maximumsize = { 250 54 }
                          item = { icon = { size = { 25 25 } texture = "[Trait.GetIcon( Character.GetSex )]" } }
                        }
                      }
                    }
                    vbox = {
                      min_width = 180 max_width = 180
                      spacing = 1
                      text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_ROW_CUCK_XP max_width = 180 default_format = "#weak" align = left }
                    }
                    expand = {}
                  }
                }
              }
            }
          }
          hbox = {
            layoutpolicy_horizontal = expanding
            spacing = 6
            button_standard_small = {
              text = DOMCOM_UI_WORLD_FIRST
              size = { 90 30 }
              enabled = "[GetScriptedGui('domcom_ui_world_first').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
              onclick = "[GetScriptedGui('domcom_ui_world_first').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            }
            button_standard_small = {
              text = DOMCOM_UI_WORLD_PREV
