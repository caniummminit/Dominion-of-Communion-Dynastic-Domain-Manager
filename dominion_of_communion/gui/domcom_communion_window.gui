                    enabled = "[GetScriptedGui('domcom_ui_deep_scan').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                    onclick = "[GetScriptedGui('domcom_ui_deep_scan').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                  }
                  expand = {}
                }

                text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_IMPERIAL_NOTE default_format = "#P" }
              }
            }
          }
        }

        # LEDGER
        vbox = {
          visible = "[GetScriptedGui('domcom_ui_is_page_ledger').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
          layoutpolicy_horizontal = expanding
          layoutpolicy_vertical = expanding
          spacing = 10

          text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_LEDGER_TITLE fontsize = 22 min_height = 30 align = left }

          scrollbox = {
            name = "domcom_ledger_scroll"
            layoutpolicy_horizontal = expanding
            layoutpolicy_vertical = expanding
            min_height = 300
            blockoverride "scrollbox_content" {
              vbox = {
                layoutpolicy_horizontal = expanding
                spacing = 10

                text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_LEDGER_FLAVOR default_format = "#weak" }
                divider = { layoutpolicy_horizontal = expanding }
                text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_LEDGER_ALPHA_TITLE fontsize = 15 min_height = 22 align = center }
                text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_LEDGER_ALPHA }
                divider = { layoutpolicy_horizontal = expanding }
                text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_LEDGER_COMMUNION_TITLE fontsize = 15 min_height = 22 align = center }
                text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_LEDGER_COMMUNION }
                divider = { layoutpolicy_horizontal = expanding }
                text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_LEDGER_NOTE default_format = "#weak" }

                hbox = {
                  layoutpolicy_horizontal = expanding
                  expand = {}
                  button_standard = { text = DOMCOM_UI_REFRESH size = { 240 36 } onclick = "[GetScriptedGui('domcom_ui_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                  expand = {}
                }

                divider = { layoutpolicy_horizontal = expanding }
                vbox = {
                  visible = "[GetScriptedGui('domcom_ui_debug_tools_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                  layoutpolicy_horizontal = expanding
                  spacing = 6
                  text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_MAINTENANCE_TITLE fontsize = 15 min_height = 22 align = center }
                  text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_MAINTENANCE_DESC default_format = "#weak" }
                  hbox = {
                    layoutpolicy_horizontal = expanding
                    spacing = 10
                    expand = {}
                    button_standard = {
                      text = DOMCOM_UI_REBUILD_DISPLAY size = { 285 36 }
                      tooltip = DOMCOM_UI_REBUILD_DISPLAY_TT
                      enabled = "[GetScriptedGui('domcom_ui_rebuild_endowment_display').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                      onclick = "[GetScriptedGui('domcom_ui_rebuild_endowment_display').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                    }
                    button_standard = {
                      text = DOMCOM_UI_REROLL_ENDOWMENTS size = { 285 36 }
                      tooltip = DOMCOM_UI_REROLL_ENDOWMENTS_TT
                      enabled = "[GetScriptedGui('domcom_ui_reroll_endowments').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                      onclick = "[GetScriptedGui('domcom_ui_reroll_endowments').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                    }
                    expand = {}
                  }
                }
              }
            }
          }
        }

        # HOW TO USE
        vbox = {
          visible = "[GetScriptedGui('domcom_ui_is_page_help').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
          layoutpolicy_horizontal = expanding
          layoutpolicy_vertical = expanding
          spacing = 8

          text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_HELP_TITLE fontsize = 22 min_height = 30 align = left }

          scrollbox = {
            name = "domcom_help_scroll"
            layoutpolicy_horizontal = expanding
            layoutpolicy_vertical = expanding
            min_height = 300
            blockoverride "scrollbox_content" {
              vbox = {
                layoutpolicy_horizontal = expanding
                spacing = 8

                text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_HELP_QUICK default_format = "#high" }
                divider = { layoutpolicy_horizontal = expanding }
                text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_HELP_FLOW_TITLE fontsize = 15 min_height = 22 align = center }
                text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_HELP_FLOW }
                divider = { layoutpolicy_horizontal = expanding }
                text_single = { layoutpolicy_horizontal = expanding text = DOMCOM_UI_HELP_SPECIAL_TITLE fontsize = 15 min_height = 22 align = center }
                text_multi = { autoresize = yes max_width = 828 layoutpolicy_horizontal = expanding text = DOMCOM_UI_HELP_SPECIAL default_format = "#weak" }
              }
            }
          }
        }
      }
    }
  }
}
