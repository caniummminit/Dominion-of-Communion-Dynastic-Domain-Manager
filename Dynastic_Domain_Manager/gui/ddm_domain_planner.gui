                    hbox = {
                      layoutpolicy_horizontal = expanding spacing = 12
                      expand = {}
                      button_standard = { text = DDM_UI_TOOL_DYNASTY size = { 235 38 } onclick = "[GetScriptedGui('ddm_ui_open_dynasty_review').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      button_standard = { text = DDM_UI_TOOL_MILITARY size = { 235 38 } onclick = "[GetScriptedGui('ddm_ui_open_military').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
