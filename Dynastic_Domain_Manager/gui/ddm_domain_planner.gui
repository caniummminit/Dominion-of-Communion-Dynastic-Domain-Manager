                button_standard_small = { text = DDM_UI_OUTSIDERS_CLEAR_ALL size = { 215 32 } tooltip = DDM_UI_OUTSIDERS_CLEAR_ALL_TT onclick = "[GetScriptedGui('ddm_ui_outsider_clear_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                button_standard_small = { text = DDM_UI_OUTSIDERS_REFRESH size = { 215 32 } tooltip = DDM_UI_OUTSIDERS_REFRESH_TT onclick = "[GetScriptedGui('ddm_ui_outsider_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                expand = {}
              }
              hbox = {
                layoutpolicy_horizontal = expanding spacing = 6
                text_single = { text = DDM_UI_SORT_LABEL size = { 58 26 } align = right default_format = "#weak" }
                button_standard_small = { text = DDM_UI_SORT_HIERARCHY size = { 125 26 } tooltip = DDM_UI_SORT_HIERARCHY_TT onclick = "[GetScriptedGui('ddm_ui_sort_hierarchy').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                button_standard_small = { text = DDM_UI_SORT_DEVELOPMENT size = { 120 26 } onclick = "[GetScriptedGui('ddm_ui_sort_development').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                button_standard_small = { text = DDM_UI_SORT_FAITH size = { 90 26 } onclick = "[GetScriptedGui('ddm_ui_sort_faith').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                button_standard_small = { text = DDM_UI_SORT_CULTURE size = { 90 26 } onclick = "[GetScriptedGui('ddm_ui_sort_culture').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                button_standard_small = { text = DDM_UI_SORT_REVERSE size = { 90 26 } tooltip = DDM_UI_SORT_REVERSE_TT onclick = "[GetScriptedGui('ddm_ui_sort_reverse').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                expand = {}
              }
              text_multi = { autoresize = yes max_width = 800 layoutpolicy_horizontal = expanding text = DDM_UI_OUTSIDERS_LIST_NOTE default_format = "#weak" }
              scrollbox = {
                name = "ddm_outsider_holdings_scroll"
                layoutpolicy_horizontal = expanding
                layoutpolicy_vertical = expanding
                min_height = 210
                blockoverride "scrollbox_content" {
                  vbox = {
                    layoutpolicy_horizontal = expanding
                    min_width = 780
                    max_width = 780
                    datamodel = "[GetPlayer.MakeScope.GetList('ddm_outsider_counties')]"
                    spacing = 4
                    item = {
                      hbox = {
                        datacontext = "[Scope.Title]"
                        layoutpolicy_horizontal = expanding
                        min_width = 780
                        max_width = 780
                        min_height = 46
                        spacing = 8

                        coa_title_tiny_crown = { using = tooltip_ne }

                        vbox = {
                          min_width = 500
                          max_width = 500
                          button_checkbox_label = {
                            layoutpolicy_horizontal = expanding
                            enabled = "[GetScriptedGui('ddm_gui_toggle_outsider_protection').IsValid(GuiScope.SetRoot(Title.MakeScope).End)]"
                            onclick = "[GetScriptedGui('ddm_gui_toggle_outsider_protection').Execute(GuiScope.SetRoot(Title.MakeScope).End)]"
                            tooltip = DDM_UI_OUTSIDERS_CHECKBOX_TT
                            blockoverride "checkbox" { checked = "[Title.MakeScope.Var('ddm_outsider_protected').IsSet]" }
                            blockoverride "text" { text = "[Title.GetNameNoTooltip]" max_width = 450 }
                          }
                        }

                        vbox = {
                          min_width = 220
                          max_width = 220
                          text_single = { layoutpolicy_horizontal = expanding text = "[Title.GetHolder.GetShortUINameNoTooltip]" max_width = 220 align = left default_format = "#weak" }
                        }
                        expand = {}
                      }
                    }
                  }
                }
              }
              hbox = { layoutpolicy_horizontal = expanding
                expand = {}
                button_primary = { text = DDM_UI_OUTSIDERS_RECLAIM_NOW size = { 300 38 } tooltip = DDM_UI_OUTSIDERS_RECLAIM_NOW_TT onclick = "[GetScriptedGui('ddm_ui_outsider_reclaim_now').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
