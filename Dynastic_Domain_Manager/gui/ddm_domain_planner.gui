                button_standard_small = { text = DDM_UI_ALLIANCE_SET_2 size = { 125 32 } onclick = "[GetScriptedGui('ddm_ui_set_alliance_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                button_standard_small = { text = DDM_UI_ALLIANCE_SET_3 size = { 125 32 } onclick = "[GetScriptedGui('ddm_ui_set_alliance_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
