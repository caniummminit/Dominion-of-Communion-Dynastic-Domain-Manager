              text_single = { layoutpolicy_horizontal = expanding text = DDM_UI_ALLIANCES_TITLE fontsize = 22 min_height = 30 align = left }
              text_multi = { autoresize = yes max_width = 800 layoutpolicy_horizontal = expanding text = DDM_UI_ALLIANCES_FLAVOR default_format = "#weak" }
              text_multi = { autoresize = yes layoutpolicy_horizontal = expanding text = DDM_UI_ALLIANCE_OFF visible = "[GetScriptedGui('ddm_ui_alliance_0').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" max_width = 800 align = center }
              text_multi = { autoresize = yes layoutpolicy_horizontal = expanding text = DDM_UI_ALLIANCE_ALL visible = "[GetScriptedGui('ddm_ui_alliance_1').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" max_width = 800 align = center }
