                      button_standard_small = { text = DDM_UI_SUCCESSION_SET_1 size = { 170 30 } onclick = "[GetScriptedGui('ddm_ui_set_succession_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      button_standard_small = { text = DDM_UI_SUCCESSION_SET_2 size = { 170 30 } onclick = "[GetScriptedGui('ddm_ui_set_succession_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      button_standard_small = { text = DDM_UI_SUCCESSION_SET_3 size = { 170 30 } onclick = "[GetScriptedGui('ddm_ui_set_succession_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      expand = {}
                    }
                    text_single = { text = DDM_UI_POLICIES_ALLIANCES fontsize = 15 size = { 780 22 } align = center }
                    hbox = { layoutpolicy_horizontal = expanding spacing = 8
                      expand = {}
                      button_standard_small = { text = DDM_UI_ALLIANCE_SET_0 size = { 125 30 } onclick = "[GetScriptedGui('ddm_ui_set_alliance_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      button_standard_small = { text = DDM_UI_ALLIANCE_SET_1 size = { 125 30 } onclick = "[GetScriptedGui('ddm_ui_set_alliance_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      button_standard_small = { text = DDM_UI_ALLIANCE_SET_2 size = { 125 30 } onclick = "[GetScriptedGui('ddm_ui_set_alliance_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      button_standard_small = { text = DDM_UI_ALLIANCE_SET_3 size = { 125 30 } onclick = "[GetScriptedGui('ddm_ui_set_alliance_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      expand = {}
                    }
                    divider = { layoutpolicy_horizontal = expanding }
                    text_single = { text = DDM_UI_POLICIES_FLOOR fontsize = 15 size = { 780 22 } align = center }
                    text_multi = { autoresize = yes max_width = 780 layoutpolicy_horizontal = expanding text = DDM_UI_POLICIES_FLOOR_CURRENT }
                    hbox = { layoutpolicy_horizontal = expanding spacing = 8
                      expand = {}
                      button_standard_small = { text = "0" size = { 100 28 } onclick = "[GetScriptedGui('ddm_ui_policy_set_floor_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      button_standard_small = { text = "4" size = { 100 28 } onclick = "[GetScriptedGui('ddm_ui_policy_set_floor_4').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      button_standard_small = { text = "8" size = { 100 28 } onclick = "[GetScriptedGui('ddm_ui_policy_set_floor_8').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      button_standard_small = { text = "12" size = { 100 28 } onclick = "[GetScriptedGui('ddm_ui_policy_set_floor_12').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      expand = {}
                    }
                    text_single = { text = DDM_UI_POLICIES_RESERVE fontsize = 15 size = { 780 22 } align = center }
                    text_multi = { autoresize = yes max_width = 780 layoutpolicy_horizontal = expanding text = DDM_UI_MILITARY_RESERVE }
                    hbox = { layoutpolicy_horizontal = expanding spacing = 6
                      expand = {}
                      button_standard_small = { text = "0" size = { 95 28 } onclick = "[GetScriptedGui('ddm_ui_set_reserve_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      button_standard_small = { text = "500" size = { 95 28 } onclick = "[GetScriptedGui('ddm_ui_set_reserve_500').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      button_standard_small = { text = "1,000" size = { 95 28 } onclick = "[GetScriptedGui('ddm_ui_set_reserve_1000').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      button_standard_small = { text = "2,500" size = { 95 28 } onclick = "[GetScriptedGui('ddm_ui_set_reserve_2500').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      button_standard_small = { text = "5,000" size = { 95 28 } onclick = "[GetScriptedGui('ddm_ui_set_reserve_5000').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      expand = {}
                    }
                  }
                }
              }
            }

            # TOOLS
            vbox = {
              visible = "[GetScriptedGui('ddm_ui_is_page_tools').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
              layoutpolicy_horizontal = expanding
              layoutpolicy_vertical = expanding
              spacing = 8

              text_single = { layoutpolicy_horizontal = expanding text = DDM_UI_TOOLS_TITLE fontsize = 22 min_height = 30 align = left }

              scrollbox = {
                name = "ddm_tools_scroll"
                layoutpolicy_horizontal = expanding
                layoutpolicy_vertical = expanding
                min_height = 300
                blockoverride "scrollbox_content" {
                  vbox = {
                    layoutpolicy_horizontal = expanding
                    spacing = 10

                    text_multi = { autoresize = yes max_width = 780 layoutpolicy_horizontal = expanding text = DDM_UI_TOOLS_FLAVOR default_format = "#weak" }
                    divider = { layoutpolicy_horizontal = expanding }

                    hbox = {
                      layoutpolicy_horizontal = expanding spacing = 12
                      expand = {}
                      button_standard = { text = DDM_UI_TOOL_DYNASTY size = { 235 38 } onclick = "[GetScriptedGui('ddm_ui_open_dynasty_review').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      button_standard = { text = DDM_UI_TOOL_MILITARY size = { 235 38 } onclick = "[GetScriptedGui('ddm_ui_open_military').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      expand = {}
                    }
                    hbox = {
                      layoutpolicy_horizontal = expanding spacing = 12
                      expand = {}
                      button_standard = { text = DDM_UI_TOOL_ADMIN size = { 235 38 } onclick = "[GetScriptedGui('ddm_ui_open_admin').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      button_standard = { text = DDM_UI_TOOL_RECLAIM size = { 235 38 } tooltip = DDM_UI_DYNASTY_RECLAIM_TT onclick = "[GetScriptedGui('ddm_ui_set_page_outsiders').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      expand = {}
                    }

                    divider = { layoutpolicy_horizontal = expanding }
                    hbox = {
                      layoutpolicy_horizontal = expanding spacing = 12
                      expand = {}
                      button_standard = {
                        text = DDM_UI_TOOL_EDUCATE
                        size = { 235 38 }
                        tooltip = DDM_UI_TOOL_EDUCATE_TT
                        onclick = "[GetScriptedGui('ddm_ui_set_page_education').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                      }
                      expand = {}
                    }
                    divider = { layoutpolicy_horizontal = expanding }
                    text_multi = { autoresize = yes max_width = 780 layoutpolicy_horizontal = expanding text = DDM_UI_TOOLS_LEGACY_NOTE default_format = "#weak" }
                  }
                }
              }
            }

            # RECORDS
            vbox = {
              visible = "[GetScriptedGui('ddm_ui_is_page_records').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
              layoutpolicy_horizontal = expanding
              layoutpolicy_vertical = expanding
              spacing = 8

              text_single = { layoutpolicy_horizontal = expanding text = DDM_UI_RECORDS_TITLE fontsize = 22 min_height = 30 align = left }

              scrollbox = {
                name = "ddm_records_scroll"
                layoutpolicy_horizontal = expanding
                layoutpolicy_vertical = expanding
                min_height = 300
                blockoverride "scrollbox_content" {
                  vbox = {
                    layoutpolicy_horizontal = expanding
                    spacing = 10

                    text_multi = { autoresize = yes max_width = 780 layoutpolicy_horizontal = expanding text = DDM_UI_RECORDS_FLAVOR default_format = "#weak" }
                    divider = { layoutpolicy_horizontal = expanding }

                    text_single = { layoutpolicy_horizontal = expanding text = DDM_UI_RECORDS_LAST_SETTLEMENT fontsize = 15 min_height = 22 align = center }
                    text_multi = { autoresize = yes max_width = 780 layoutpolicy_horizontal = expanding text = DDM_UI_RECORDS_SETTLEMENT }
                    text_multi = { autoresize = yes text = DDM_UI_RECORDS_STALLED visible = "[GetScriptedGui('ddm_ui_distribution_stalled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" max_width = 780 default_format = "#N" }

                    divider = { layoutpolicy_horizontal = expanding }

                    text_single = { layoutpolicy_horizontal = expanding text = DDM_UI_RECORDS_PREVIEW fontsize = 15 min_height = 22 align = center }
                    text_multi = { autoresize = yes max_width = 780 layoutpolicy_horizontal = expanding text = DDM_UI_RECORDS_PREVIEW_COUNTS }
                    text_multi = { autoresize = yes text = DDM_UI_RECORDS_PREVIEW_1 visible = "[GetScriptedGui('ddm_ui_has_preview_1').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" max_width = 780 }
                    text_multi = { autoresize = yes text = DDM_UI_RECORDS_PREVIEW_2 visible = "[GetScriptedGui('ddm_ui_has_preview_2').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" max_width = 780 }
                    text_multi = { autoresize = yes text = DDM_UI_RECORDS_PREVIEW_3 visible = "[GetScriptedGui('ddm_ui_has_preview_3').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" max_width = 780 }

                    divider = { layoutpolicy_horizontal = expanding }
                    hbox = {
                      layoutpolicy_horizontal = expanding spacing = 12
                      expand = {}
                      button_standard = { text = DDM_UI_PREVIEW size = { 235 36 } onclick = "[GetScriptedGui('ddm_ui_preview').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      button_standard = { text = DDM_UI_REFRESH size = { 235 36 } onclick = "[GetScriptedGui('ddm_ui_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                      expand = {}
                    }
                  }
                }
              }
            }

      }
    }
  }
}
